        "# ----------------------------\n",
        "# Model: MobileNetV3-Large encoder + light U-Net decoder\n",
        "# ----------------------------\n",
        "def pick_mobilenetv3_encoder():\n",
        "    names = set(smp.encoders.get_encoder_names())\n",
        "    preferred = [\n",
        "        \"tu-mobilenetv3_large_100\",\n",
        "        \"timm-mobilenetv3_large_100\",\n",
        "        \"mobilenet_v3_large\"\n",
        "    ]\n",
        "    for n in preferred:\n",
        "        if n in names:\n",
        "            return n\n",
        "    raise ValueError(\"No MobileNetV3-Large encoder found in this SMP version.\")\n",
        "\n",
        "encoder_name = pick_mobilenetv3_encoder()\n",
        "print(\"Using encoder:\", encoder_name)\n",
        "\n",
        "model = smp.Unet(\n",
        "    encoder_name=encoder_name,\n",
        "    encoder_weights=\"imagenet\",\n",
        "    in_channels=3,\n",
        "    classes=NUM_CLASSES,\n",
        "    decoder_channels=(128, 64, 32, 16, 8),  # light decoder\n",
        "    decoder_use_batchnorm=True,\n",
        "    decoder_attention_type=None\n",
        ").to(device)\n",
        "\n",
        "optimizer = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n",
        "scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=NUM_EPOCHS)\n",
        "scaler = GradScaler(enabled=use_amp)\n",
        "\n",
        "class DiceLossMultiClass(nn.Module):\n",
        "    def __init__(self, smooth=1e-6):\n",
        "        super().__init__()\n",
        "        self.smooth = smooth\n",
        "\n",
        "    def forward(self, logits, target):\n",
        "        n_classes = logits.shape[1]\n",
        "        probs = torch.softmax(logits, dim=1)\n",
        "        one_hot = F.one_hot(target, num_classes=n_classes).permute(0, 3, 1, 2).float()\n",
        "\n",
        "        inter = torch.sum(probs * one_hot, dim=(0, 2, 3))\n",
        "        denom = torch.sum(probs + one_hot, dim=(0, 2, 3))\n",
        "        dice = (2.0 * inter + self.smooth) / (denom + self.smooth)\n",
        "\n",
        "        if n_classes > 1:\n",
        "            return 1.0 - dice[1:].mean()\n",
        "        return 1.0 - dice.mean()\n",
        "\n",
        "ce_loss = nn.CrossEntropyLoss()\n",
        "dice_loss = DiceLossMultiClass()\n",
        "\n",
        "def criterion(logits, target, alpha=0.7):\n",
        "    return alpha * ce_loss(logits, target) + (1 - alpha) * dice_loss(logits, target)\n",
        "\n",
        "def compute_metrics(logits, target, n_classes):\n",
        "    with torch.inference_mode():\n",
        "        pred = logits.argmax(dim=1).reshape(-1)\n",
        "        tgt = target.reshape(-1)\n",
        "        valid = (tgt >= 0) & (tgt < n_classes)\n",
        "        pred = pred[valid]\n",
        "        tgt = tgt[valid]\n",
        "\n",
        "        k = tgt * n_classes + pred\n",
        "        cm = torch.bincount(k, minlength=n_classes*n_classes).reshape(n_classes, n_classes)\n",
        "\n",
        "        tp = cm.diag()\n",
        "        fp = cm.sum(0) - tp\n",
        "        fn = cm.sum(1) - tp\n",
        "\n",
        "        union = tp + fp + fn\n",
        "        iou = torch.where(union > 0, tp.float() / union.float(), torch.zeros_like(tp, dtype=torch.float))\n",
        "\n",
        "        denom = 2 * tp + fp + fn\n",
        "        dice = torch.where(denom > 0, (2 * tp).float() / denom.float(), torch.zeros_like(tp, dtype=torch.float))\n",
        "\n",
        "        if n_classes > 1:\n",
        "            return iou[1:].mean().item(), dice[1:].mean().item()\n",
        "        return iou.mean().item(), dice.mean().item()"
      ],
