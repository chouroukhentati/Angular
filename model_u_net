        "# ----------------------------\n",
        "# Dataset + loaders\n",
        "# ----------------------------\n",
        "class DentalDataset(Dataset):\n",
        "    def __init__(self, pairs, transform=None):\n",
        "        self.pairs = pairs\n",
        "        self.transform = transform\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.pairs)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        item = self.pairs[idx]\n",
        "        img_bgr = cv2.imread(str(item[\"image\"]), cv2.IMREAD_COLOR)\n",
        "        if img_bgr is None:\n",
        "            raise RuntimeError(f\"Failed to read image: {item['image']}\")\n",
        "        img = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\n",
        "        mask = np.load(str(item[\"mask\"])).astype(np.int64)\n",
        "\n",
        "        if self.transform is not None:\n",
        "            aug = self.transform(image=img, mask=mask)\n",
        "            img = aug[\"image\"]\n",
        "            mask = aug[\"mask\"]\n",
        "\n",
        "        return img, torch.as_tensor(mask, dtype=torch.long)\n",
        "\n",
        "train_transform = A.Compose([\n",
        "    A.Resize(IMAGE_SIZE, IMAGE_SIZE),\n",
        "    A.HorizontalFlip(p=0.5),\n",
        "    A.ShiftScaleRotate(shift_limit=0.05, scale_limit=0.10, rotate_limit=10, p=0.5),\n",
        "    A.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n",
        "    ToTensorV2(),\n",
        "])\n",
        "\n",
        "val_transform = A.Compose([\n",
        "    A.Resize(IMAGE_SIZE, IMAGE_SIZE),\n",
        "    A.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n",
        "    ToTensorV2(),\n",
        "])\n",
        "\n",
        "pairs = []\n",
        "for ip in sorted(images_dir.glob(\"*.png\")):\n",
        "    mp = CACHE_DIR / f\"{ip.stem}.npy\"\n",
        "    if mp.exists():\n",
        "        pairs.append({\"image\": ip, \"mask\": mp})\n",
