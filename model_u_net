        "# ----------------------------\n",
        "# Labelmap + LUT\n",
        "# ----------------------------\n",
        "if not labelmap_path.exists():\n",
        "    candidates = sorted(DATA_ROOT.rglob(\"labelmap.txt\"))\n",
        "    if not candidates:\n",
        "        raise FileNotFoundError(\"labelmap.txt not found\")\n",
        "    labelmap_path = candidates[0]\n",
        "\n",
        "def load_labelmap(path: Path):\n",
        "    rgb_to_class, class_to_rgb = {}, {}\n",
        "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "        for line in f:\n",
        "            line = line.strip()\n",
        "            if not line or \":\" not in line:\n",
        "                continue\n",
        "            name, rgb_str = line.split(\":\", 1)\n",
        "            name = name.strip()\n",
        "            parts = [p.strip() for p in rgb_str.split(\",\")]\n",
        "            if len(parts) != 3:\n",
        "                continue\n",
        "            r, g, b = map(int, parts)\n",
        "\n",
        "            if name.lower() == \"background\":\n",
        "                class_id = 0\n",
        "            elif name.isdigit():\n",
        "                class_id = int(name)\n",
        "            else:\n",
        "                continue\n",
        "\n",
        "            rgb_to_class[(r, g, b)] = class_id\n",
        "            class_to_rgb[class_id] = (r, g, b)\n",
        "\n",
        "    if len(rgb_to_class) == 0:\n",
        "        raise ValueError(\"Invalid or empty labelmap\")\n",
        "    return rgb_to_class, class_to_rgb\n",
        "\n",
        "def build_lut(rgb_to_class):\n",
        "    lut = np.zeros(256**3, dtype=np.uint8)\n",
        "    for (r, g, b), cls in rgb_to_class.items():\n",
        "        lut[r * 65536 + g * 256 + b] = cls\n",
        "    return lut\n",
        "\n",
        "def rgb_to_class_mask(mask_rgb, lut):\n",
        "    packed = (\n",
        "        mask_rgb[:, :, 0].astype(np.int32) * 65536\n",
        "        + mask_rgb[:, :, 1].astype(np.int32) * 256\n",
        "        + mask_rgb[:, :, 2].astype(np.int32)\n",
        "    )\n",
        "    return lut[packed].astype(np.uint8)\n",
        "\n",
        "rgb_to_class, class_to_rgb = load_labelmap(labelmap_path)\n",
        "LUT = build_lut(rgb_to_class)\n",
        "print(\"Labelmap classes:\", len(class_to_rgb))"
