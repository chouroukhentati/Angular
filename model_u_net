        "import matplotlib.pyplot as plt\n",
        "\n",
        "def train_one_epoch(model, loader):\n",
        "    model.train()\n",
        "    running_loss = 0.0\n",
        "    n_batches = 0\n",
        "\n",
        "    for imgs, masks in loader:\n",
        "        imgs = imgs.to(device, non_blocking=True)\n",
        "        masks = masks.to(device, non_blocking=True)\n",
        "\n",
        "        optimizer.zero_grad(set_to_none=True)\n",
        "        with autocast(enabled=use_amp):\n",
        "            logits = model(imgs)\n",
        "            loss = criterion(logits, masks)\n",
        "\n",
        "        scaler.scale(loss).backward()\n",
        "        scaler.step(optimizer)\n",
        "        scaler.update()\n",
        "\n",
        "        running_loss += float(loss.item())\n",
        "        n_batches += 1\n",
        "\n",
        "    return running_loss / max(1, n_batches)\n",
        "\n",
        "def validate_one_epoch(model, loader):\n",
        "    model.eval()\n",
        "    running_loss = 0.0\n",
        "    miou_scores, dice_scores = [], []\n",
        "    n_batches = 0\n",
        "\n",
        "    with torch.inference_mode():\n",
        "        for imgs, masks in loader:\n",
        "            imgs = imgs.to(device, non_blocking=True)\n",
        "            masks = masks.to(device, non_blocking=True)\n",
        "\n",
        "            with autocast(enabled=use_amp):\n",
        "                logits = model(imgs)\n",
        "                loss = criterion(logits, masks)\n",
        "\n",
        "            running_loss += float(loss.item())\n",
        "            n_batches += 1\n",
        "\n",
        "            miou, dice = compute_metrics(logits, masks, NUM_CLASSES)\n",
        "            miou_scores.append(miou)\n",
        "            dice_scores.append(dice)\n",
        "\n",
        "    val_loss = running_loss / max(1, n_batches)\n",
        "    val_miou = float(np.mean(miou_scores)) if miou_scores else 0.0\n",
        "    val_dice = float(np.mean(dice_scores)) if dice_scores else 0.0\n",
        "    return val_loss, val_miou, val_dice\n",
        "\n",
        "train_losses, val_losses = [], []\n",
        "val_mious, val_dices = [], []\n",
        "best_val_miou = -1.0\n",
        "best_epoch = 0\n",
        "patience = 0\n",
        "\n",
        "for epoch in range(1, NUM_EPOCHS + 1):\n",
        "    t0 = time.time()\n",
        "\n",
        "    train_loss = train_one_epoch(model, loader)\n",
        "    val_loss, val_miou, val_dice = validate_one_epoch(model, val_loader)\n",
        "    scheduler.step()\n",
        "\n",
        "    train_losses.append(train_loss)\n",
        "    val_losses.append(val_loss)\n",
        "    val_mious.append(val_miou)\n",
        "    val_dices.append(val_dice)\n",
        "\n",
        "    dt = time.time() - t0\n",
        "    print(\n",
        "        f\"Epoch [{epoch}/{NUM_EPOCHS}] \"\n",
        "        f\"train_loss={train_loss:.6f} | val_loss={val_loss:.6f} | \"\n",
        "        f\"val_mIoU={val_miou:.4f} | val_Dice={val_dice:.4f} | {dt:.1f}s\"\n",
        "    )\n",
        "\n",
        "    if val_miou > best_val_miou:\n",
        "        best_val_miou = val_miou\n",
        "        best_epoch = epoch\n",
        "        patience = 0\n",
        "        torch.save({\n",
        "            \"epoch\": epoch,\n",
        "            \"model_state_dict\": model.state_dict(),\n",
        "            \"optimizer_state_dict\": optimizer.state_dict(),\n",
        "            \"scaler_state_dict\": scaler.state_dict(),\n",
        "            \"best_val_miou\": best_val_miou\n",
        "        }, BEST_PATH)\n",
        "        print(f\"  Saved best model at epoch {epoch} (mIoU={best_val_miou:.4f})\")\n",
        "    else:\n",
        "        patience += 1\n",
        "\n",
        "    if patience >= EARLY_STOP_PATIENCE:\n",
        "        print(f\"Early stopping at epoch {epoch}\")\n",
        "        break\n",
        "\n",
        "print(\"\\nTraining done\")\n",
        "print(f\"Best epoch: {best_epoch}, best val mIoU: {best_val_miou:.4f}\")\n",
        "\n",
        "# Test with best checkpoint\n",
        "ckpt = torch.load(BEST_PATH, map_location=device)\n",
        "model.load_state_dict(ckpt[\"model_state_dict\"])\n",
        "test_loss, test_miou, test_dice = validate_one_epoch(model, test_loader)\n",
        "print(f\"Test: loss={test_loss:.6f} | mIoU={test_miou:.4f} | Dice={test_dice:.4f}\")\n",
        "\n",
        "# Curves\n",
        "plt.figure(figsize=(12, 4))\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.plot(train_losses, label=\"train_loss\")\n",
        "plt.plot(val_losses, label=\"val_loss\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.title(\"Loss\")\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.plot(val_mious, label=\"val_mIoU\")\n",
        "plt.plot(val_dices, label=\"val_Dice\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.title(\"Validation metrics\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# One qualitative example from test set\n",
