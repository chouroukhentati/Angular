        "model = smp.UnetPlusPlus(\n",
        "    encoder_name=\"efficientnet-b5\",\n",
        "    encoder_weights=\"imagenet\",\n",
        "    in_channels=3,\n",
        "    classes=NUM_CLASSES,\n",
        "    decoder_attention_type=\"scse\",\n",
        "    decoder_dropout=0.3,\n",
        ").to(device)\n",
        "\n",
        "optimizer = torch.optim.AdamW(model.parameters(), lr=LR)\n",
        "criterion = nn.CrossEntropyLoss()\n",
        "scaler = GradScaler(enabled=use_amp)\n",
        "\n",
        "def compute_metrics(pred_logits, target, num_classes):\n",
        "    with torch.inference_mode():\n",
        "        pred = pred_logits.argmax(dim=1).reshape(-1)\n",
        "        tgt = target.reshape(-1).to(pred.device)\n",
        "\n",
        "        valid = (tgt >= 0) & (tgt < num_classes)\n",
        "        pred = pred[valid]\n",
        "        tgt = tgt[valid]\n",
        "\n",
        "        k = tgt * num_classes + pred\n",
        "        cm = torch.bincount(k, minlength=num_classes*num_classes).reshape(num_classes, num_classes)\n",
        "\n",
        "        tp = cm.diag()\n",
        "        fp = cm.sum(0) - tp\n",
        "        fn = cm.sum(1) - tp\n",
        "\n",
        "        union = tp + fp + fn\n",
        "        iou = torch.where(union > 0, tp.float() / union.float(), torch.zeros_like(tp, dtype=torch.float))\n",
        "        denom = 2*tp + fp + fn\n",
        "        dice = torch.where(denom > 0, (2*tp).float() / denom.float(), torch.zeros_like(tp, dtype=torch.float))\n",
        "\n",
        "        if num_classes > 1:\n",
        "            return {\"miou\": iou[1:].mean().item(), \"dice\": dice[1:].mean().item()}\n",
        "        return {\"miou\": iou.mean().item(), \"dice\": dice.mean().item()}\n",
        "\n",
        "def evaluate_one_epoch(model, loader, criterion, device, use_amp, num_classes):\n",
        "    model.eval()\n",
        "    total_loss, n_batches = 0.0, 0\n",
        "    miou_list, dice_list = [], []\n",
        "\n",
        "    with torch.inference_mode():\n",
        "        for imgs, masks in loader:\n",
        "            imgs = imgs.to(device, non_blocking=True)\n",
        "            masks = masks.to(device, non_blocking=True)\n",
        "\n",
        "            with autocast(enabled=use_amp):\n",
        "                preds = model(imgs)\n",
        "                loss = criterion(preds, masks)\n",
        "\n",
        "            total_loss += loss.item()\n",
        "            n_batches += 1\n",
        "\n",
        "            m = compute_metrics(preds, masks, num_classes)\n",
        "            miou_list.append(m[\"miou\"])\n",
        "            dice_list.append(m[\"dice\"])\n",
        "\n",
        "    return (\n",
        "        total_loss / max(1, n_batches),\n",
        "        float(np.mean(miou_list)) if miou_list else 0.0,\n",
        "        float(np.mean(dice_list)) if dice_list else 0.0,\n",
        "    )"
      ],
