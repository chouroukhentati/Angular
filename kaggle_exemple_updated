      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def train_one_epoch(model, loader, optimizer, criterion, scaler, device, use_amp, num_classes, profile_batches=0):\n",
        "    model.train()\n",
        "    total_loss, n_batches = 0.0, 0\n",
        "    times = {\"data_load\": [], \"host_to_device\": [], \"forward\": [], \"backward\": [], \"metrics\": []}\n",
        "\n",
        "    example = {\"img\": None, \"gt\": None, \"pred\": None}\n",
        "    it = iter(loader)\n",
        "\n",
        "    while True:\n",
        "        t0 = time.perf_counter()\n",
        "        try:\n",
        "            imgs, masks = next(it)\n",
        "        except StopIteration:\n",
        "            break\n",
        "        t1 = time.perf_counter()\n",
        "\n",
        "        do_profile = n_batches < profile_batches\n",
        "        if do_profile:\n",
        "            times[\"data_load\"].append(t1 - t0)\n",
        "\n",
        "        imgs = imgs.to(device, non_blocking=True)\n",
        "        masks = masks.to(device, non_blocking=True)\n",
        "        if do_profile and torch.cuda.is_available():\n",
        "            torch.cuda.synchronize()\n",
        "        t2 = time.perf_counter()\n",
        "        if do_profile:\n",
        "            times[\"host_to_device\"].append(t2 - t1)\n",
        "\n",
        "        optimizer.zero_grad(set_to_none=True)\n",
        "        with autocast(enabled=use_amp):\n",
        "            preds = model(imgs)\n",
        "            loss = criterion(preds, masks)\n",
        "        if do_profile and torch.cuda.is_available():\n",
        "            torch.cuda.synchronize()\n",
        "        t3 = time.perf_counter()\n",
        "        if do_profile:\n",
        "            times[\"forward\"].append(t3 - t2)\n",
        "\n",
        "        scaler.scale(loss).backward()\n",
        "        scaler.step(optimizer)\n",
        "        scaler.update()\n",
        "        if do_profile and torch.cuda.is_available():\n",
        "            torch.cuda.synchronize()\n",
        "        t4 = time.perf_counter()\n",
        "        if do_profile:\n",
        "            times[\"backward\"].append(t4 - t3)\n",
        "\n",
        "        with torch.inference_mode():\n",
        "            _ = compute_metrics(preds.detach(), masks.detach(), num_classes)\n",
        "        if do_profile and torch.cuda.is_available():\n",
        "            torch.cuda.synchronize()\n",
        "        t5 = time.perf_counter()\n",
        "        if do_profile:\n",
        "            times[\"metrics\"].append(t5 - t4)\n",
        "\n",
        "        total_loss += loss.item()\n",
        "        n_batches += 1\n",
        "\n",
        "        if example[\"img\"] is None:\n",
        "            with torch.inference_mode():\n",
        "                pred_cls = preds.argmax(dim=1)\n",
        "            example[\"img\"] = imgs[0].detach().cpu()\n",
        "            example[\"gt\"] = masks[0].detach().cpu()\n",
        "            example[\"pred\"] = pred_cls[0].detach().cpu()\n",
        "\n",
        "    return total_loss / max(1, n_batches), times, example\n",
        "\n",
        "def print_profile(times, loader_len):\n",
        "    valid = {k: v for k, v in times.items() if len(v) > 0}\n",
        "    if not valid:\n",
        "        return\n",
        "    total = sum(np.mean(v) for v in valid.values())\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 55)\n",
        "    print(\"TIMING RESULTS\")\n",
        "    print(\"=\" * 55)\n",
        "    for k in [\"data_load\", \"host_to_device\", \"forward\", \"backward\", \"metrics\"]:\n",
        "        if k not in valid:\n",
        "            continue\n",
        "        mean_ms = np.mean(valid[k]) * 1000\n",
        "        pct = np.mean(valid[k]) / total * 100 if total > 0 else 0\n",
        "        print(f\"{k:<20} {mean_ms:7.1f} ms  {pct:5.1f}%\")\n",
        "    print(\"-\" * 55)\n",
        "    print(f\"{'TOTAL per batch':<20} {total*1000:7.1f} ms\")\n",
        "    est = total * loader_len\n",
        "    print(f\"{'Estimated epoch':<20} {est:7.1f} s ({est/60:.1f} min)\")\n",
        "\n",
        "def show_example_triplet(example, num_classes):\n",
        "    if example[\"img\"] is None:\n",
        "        return\n",
        "    img = example[\"img\"]\n",
        "    mean = torch.tensor([0.485, 0.456, 0.406]).view(3, 1, 1)\n",
        "    std = torch.tensor([0.229, 0.224, 0.225]).view(3, 1, 1)\n",
        "    img = (img * std + mean).clamp(0, 1)\n",
        "    img = img.permute(1, 2, 0).numpy()\n",
        "\n",
        "    gt = example[\"gt\"].numpy()\n",
        "    pred = example[\"pred\"].numpy()\n",
        "    vmax = max(1, num_classes - 1)\n",
        "\n",
        "    fig, ax = plt.subplots(1, 3, figsize=(15, 5))\n",
        "    ax[0].imshow(img);  ax[0].set_title(\"Input\");       ax[0].axis(\"off\")\n",
        "    ax[1].imshow(gt, cmap=\"tab20\", vmin=0, vmax=vmax); ax[1].set_title(\"Ground Truth\"); ax[1].axis(\"off\")\n",
        "    ax[2].imshow(pred, cmap=\"tab20\", vmin=0, vmax=vmax); ax[2].set_title(\"Prediction\"); ax[2].axis(\"off\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "train_losses, val_losses, val_mious, val_dices = [], [], [], []\n",
        "best_val_miou = -1.0\n",
        "best_epoch = -1\n",
        "\n",
        "for epoch in range(1, NUM_EPOCHS + 1):\n",
        "    train_loss, times, example = train_one_epoch(\n",
        "        model, loader, optimizer, criterion, scaler, device, use_amp, NUM_CLASSES,\n",
        "        profile_batches=PROFILE_BATCHES\n",
        "    )\n",
        "    val_loss, val_miou, val_dice = evaluate_one_epoch(\n",
        "        model, val_loader, criterion, device, use_amp, NUM_CLASSES\n",
        "    )\n",
        "\n",
        "    train_losses.append(train_loss)\n",
        "    val_losses.append(val_loss)\n",
        "    val_mious.append(val_miou)\n",
        "    val_dices.append(val_dice)\n",
        "\n",
        "    print(f\"Epoch [{epoch}/{NUM_EPOCHS}] \"\n",
        "          f\"train_loss={train_loss:.6f} | val_loss={val_loss:.6f} | \"\n",
        "          f\"val_mIoU={val_miou:.4f} | val_Dice={val_dice:.4f}\")\n",
        "\n",
        "    print_profile(times, len(loader))\n",
        "    show_example_triplet(example, NUM_CLASSES)\n",
        "\n",
        "    if val_miou > best_val_miou:\n",
        "        best_val_miou = val_miou\n",
        "        best_epoch = epoch\n",
        "        torch.save({\n",
        "            \"epoch\": epoch,\n",
        "            \"model_state_dict\": model.state_dict(),\n",
        "            \"optimizer_state_dict\": optimizer.state_dict(),\n",
        "            \"scaler_state_dict\": scaler.state_dict(),\n",
        "            \"best_val_miou\": best_val_miou\n",
        "        }, BEST_PATH)\n",
        "        print(f\"  -> Best model saved (epoch {epoch}, mIoU={best_val_miou:.4f})\")\n",
        "\n",
        "print(\"\\nTraining terminé.\")\n",
        "print(f\"Best epoch: {best_epoch}, best val mIoU: {best_val_miou:.4f}\")\n",
        "\n",
        "# Courbes\n",
        "plt.figure(figsize=(12, 4))\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.plot(train_losses, label=\"train_loss\")\n",
        "plt.plot(val_losses, label=\"val_loss\")\n",
        "plt.legend(); plt.grid(alpha=0.3); plt.title(\"Loss\")\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.plot(val_mious, label=\"val_mIoU\")\n",
        "plt.plot(val_dices, label=\"val_Dice\")\n",
        "plt.legend(); plt.grid(alpha=0.3); plt.title(\"Val metrics\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
